{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@nft-lint/core": ["../core/src/index.ts"],
      "@nft-lint/preset": ["../preset/src/index.ts"],
      "@nft-lint/rules-evm": ["../rules-evm/src/index.ts"],
      "@nft-lint/rules-solana": ["../rules-solana/src/index.ts"],
      "@nft-lint/rules-media": ["../rules-media/src/index.ts"],
      "@nft-lint/rules-tezos": ["../rules-tezos/src/index.ts"],
      "@nft-lint/rules-bitcoin": ["../rules-bitcoin/src/index.ts"],
      "@nft-lint/rules-ton": ["../rules-ton/src/index.ts"],
      "@nft-lint/rules-flow": ["../rules-flow/src/index.ts"],
      "@nft-lint/rules-tron": ["../rules-tron/src/index.ts"],
      "@nft-lint/rules-cardano": ["../rules-cardano/src/index.ts"],
      "@nft-lint/rules-algorand": ["../rules-algorand/src/index.ts"],
      "@nft-lint/rules-sui": ["../rules-sui/src/index.ts"],
      "@nft-lint/rules-aptos": ["../rules-aptos/src/index.ts"],
      "@nft-lint/rules-stargaze": ["../rules-stargaze/src/index.ts"]
    }
  },
  "include": ["src"]
}
