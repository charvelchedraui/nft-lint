{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@nft-lint/core": ["../core/src/index.ts"],
      "@nft-lint/preset": ["../preset/src/index.ts"],
      "@nft-lint/rules-evm": ["../rules-evm/src/index.ts"],
      "@nft-lint/rules-solana": ["../rules-solana/src/index.ts"],
      "@nft-lint/rules-media": ["../rules-media/src/index.ts"]
    }
  },
  "include": ["src"]
}
