{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@nft-lint/core": ["packages/core/src/index.ts"],
      "@nft-lint/rules-evm": ["packages/rules-evm/src/index.ts"],
      "@nft-lint/rules-solana": ["packages/rules-solana/src/index.ts"],
      "@nft-lint/rules-media": ["packages/rules-media/src/index.ts"],
      "@nft-lint/rules-tezos": ["packages/rules-tezos/src/index.ts"],
      "@nft-lint/rules-bitcoin": ["packages/rules-bitcoin/src/index.ts"],
      "@nft-lint/rules-ton": ["packages/rules-ton/src/index.ts"],
      "@nft-lint/rules-flow": ["packages/rules-flow/src/index.ts"],
      "@nft-lint/rules-tron": ["packages/rules-tron/src/index.ts"],
      "@nft-lint/rules-cardano": ["packages/rules-cardano/src/index.ts"],
      "@nft-lint/rules-algorand": ["packages/rules-algorand/src/index.ts"],
      "@nft-lint/rules-sui": ["packages/rules-sui/src/index.ts"],
      "@nft-lint/rules-aptos": ["packages/rules-aptos/src/index.ts"],
      "@nft-lint/rules-stargaze": ["packages/rules-stargaze/src/index.ts"],
      "@nft-lint/fetchers": ["packages/fetchers/src/index.ts"],
      "@nft-lint/preset": ["packages/preset/src/index.ts"],
      "nft-lint": ["packages/cli/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"],
  "exclude": ["packages/web/**", "**/dist/**"]
}
