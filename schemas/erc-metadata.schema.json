{
  "$id": "https://github.com/charvelchedraui/nft-lint/blob/main/schemas/erc-metadata.schema.json",
  "title": "ERC-721 / ERC-1155 metadata JSON",
  "type": "object",
  "additionalProperties": true,
  "required": ["name", "description", "image"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "external_url": {
      "type": "string"
    },
    "animation_url": {
      "type": "string"
    },
    "youtube_url": {
      "type": "string"
    },
    "background_color": {
      "type": "string"
    }
  }
}
